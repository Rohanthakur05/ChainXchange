# ─── Server ───────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# Set to true only behind HTTPS (Render/Railway). For local HTTP use false.
COOKIE_SECURE=false
# Allow auth cookies over HTTP during local production testing
FORCE_HTTP_COOKIES=true

# ─── Frontend (comma-separated for multiple origins) ──────────
CLIENT_URL=http://localhost:5173,http://localhost:5174
# Production (Render): include your Vercel URL for CORS
# CLIENT_URL=https://chain-xchange-seven.vercel.app

# Cross-origin cookies (Vercel + Render): none in production, lax locally
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# ─── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/crypto-trading

# ─── Redis (optional — caching disabled if unset) ─────────────
REDIS_URL=

# ─── Auth secrets (CHANGE IN PRODUCTION) ──────────────────────
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
COOKIE_SECRET=your_super_secret_cookie_key
SESSION_SECRET=your_super_secret_session_key

# ─── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ─── Payments ─────────────────────────────────────────────────
PAYMENT_MAX_DEPOSIT=100000

# ─── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
TRUST_PROXY=true
